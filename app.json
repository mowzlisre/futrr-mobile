{
  "expo": {
    "name": "futrr",
    "slug": "futrr-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "futrr",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "futrr uses your location to show nearby time capsules on the Atlas."
      },
      "bundleIdentifier": "com.mowzlisre.futrr"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.mowzlisre.futrr"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.ico"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-location",
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-video",
      [
        "expo-notifications",
        {
          "iosDisplayInForeground": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f839df93-b24b-417e-a1bd-f2ffca27c9d6"
      }
    },
    "owner": "futrr-app"
  }
}
