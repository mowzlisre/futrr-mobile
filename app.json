{
  "expo": {
    "name": "Futrr",
    "slug": "futrr",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "futrr",
    "owner": "futrr",
    "splash": {
      "image": "./assets/futrr-banner-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "1",
      "bundleIdentifier": "com.futrr.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "futrr uses your location to show nearby time capsules on the Atlas. Your location is never collected, stored or shared to any 3rd party services.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 1,
      "package": "com.futrr.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.ico"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Moul.ttf",
            "./assets/fonts/MrsSans.ttf",
            "./assets/fonts/ionicons.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "expo-location",
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-video",
      [
        "expo-notifications",
        {
          "iosDisplayInForeground": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6c53f86c-8a8c-465a-989a-b3a2293c087b"
      }
    }
  }
}
